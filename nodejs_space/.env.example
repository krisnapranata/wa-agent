# ===== MySQL SIMRS =====
DB_HOST=192.168.1.10
DB_PORT=3306
DB_USER=simrs_bot
DB_PASSWORD=rahasia
DB_NAME=simrs
DB_TIMEZONE=local
# ===== Keamanan =====
ADMIN_API_KEY=ganti_dengan_kunci_acak_panjang
# ===== WhatsApp =====
WA_ENABLED=true
AUTH_STORE=mysql            # mysql (disarankan) | file
SESSION_DIR=/home/ubuntu/wa_sessions
WA_SESSION_ID=default
BROADCAST_DELAY_MS=1500
# ===== Bot =====
BOT_ONLY_REGISTERED=true    # hanya nomor di broadcast_numbers yang dilayani
BOT_REPLY_UNREGISTERED=false
BOT_REPLY_UNKNOWN=true
# ===== Aturan alert =====
ALERT_LOOKBACK_DAYS=7
ALERT_MAX_PATIENTS=50
KONTROL_DEADLINE_HOURS=24
RESUME_DONE_STATUS=selesai
MATCH_CURRENT_VISIT=false
APP_TIMEZONE=Asia/Makassar
# ===== Nama tabel (opsional) =====
TBL_PASIEN=pasien
TBL_RESUME=resume_medis
TBL_KONTROL=surat_kontrol
TBL_DIAGNOSA=diagnosa_pasien
