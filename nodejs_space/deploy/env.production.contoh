# Salin ke nodejs_space/.env.production lalu isi. Berkas asli TIDAK di-commit.
# Hindari komentar di ujung baris (setelah nilai): tulis komentar di baris tersendiri.

# ===== MySQL SIMRS (sudah ada; bot hanya membaca + membuat tabel internalnya sendiri) =====
# Bila MySQL ada di host yang sama dengan Docker: DB_HOST=host.docker.internal
DB_HOST=192.168.1.10
DB_PORT=3306
DB_USER=simrs_bot
DB_PASSWORD=ganti
DB_NAME=simrs
DB_TIMEZONE=local

# ===== Keamanan =====
# Kunci acak panjang, mis. hasil: openssl rand -hex 32
ADMIN_API_KEY=ganti_dengan_kunci_acak_panjang

# ===== WhatsApp =====
WA_ENABLED=true
# mysql (disarankan: session di tabel wa_auth_state) | file (volume wa_sessions)
AUTH_STORE=mysql
SESSION_DIR=/app/wa_sessions
WA_SESSION_ID=default
BROADCAST_DELAY_MS=1500

# ===== Bot =====
BOT_ONLY_REGISTERED=true
BOT_REPLY_UNREGISTERED=false
BOT_REPLY_UNKNOWN=true

# ===== Aturan alert =====
ALERT_LOOKBACK_DAYS=7
ALERT_MAX_PATIENTS=50
KONTROL_DEADLINE_HOURS=24
RESUME_DONE_STATUS=selesai
MATCH_CURRENT_VISIT=false
APP_TIMEZONE=Asia/Makassar
TZ=Asia/Makassar

# ===== Scheduler (container wabot_scheduler) =====
# Jam broadcast resume & surat kontrol (zona APP_TIMEZONE), dipisah koma. Kosongkan untuk menonaktifkan.
BROADCAST_TIMES=08:00,14:00
# Interval keepalive koneksi WhatsApp (menit). 0 = nonaktif.
KEEPALIVE_MINUTES=15

# ===== Nama tabel SIMRS (opsional) =====
TBL_PASIEN=pasien
TBL_RESUME=resume_medis
TBL_KONTROL=surat_kontrol
TBL_DIAGNOSA=diagnosa_pasien
